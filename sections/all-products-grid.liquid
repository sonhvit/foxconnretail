{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_laptop = 4
  if columns_desktop < 4
    assign columns_laptop = columns_desktop
  endif
  assign columns_tablet = 3
  assign columns_mobile = section.settings.columns_mobile | times: 1
  assign products_to_display = section.settings.products_per_page | default: 32

  assign target_collection = section.settings.collection
  if target_collection == blank or target_collection.products_count == 0
    assign target_collection = collections.all
  endif

  assign anchor = '#ProductsGrid-' | append: section.id
-%}

{%- capture image_sizes -%}
(max-width: 767px) calc((100vw - 38px) / {{ columns_mobile }}),
(max-width: 1023px) calc((100vw - 90px) / {{ columns_tablet }}),
(max-width: 1279px) calc((100vw - 120px) / {{ columns_laptop }}),
{{ settings.page_width | divided_by: columns_desktop }}px
{%- endcapture -%}

{%- style -%}
  #ProductsGrid-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #ProductsGrid-{{ section.id }} .all-products-grid {
    position: relative;
  }
  #ProductsGrid-{{ section.id }} .all-products-grid.is-loading .products-list,
  #ProductsGrid-{{ section.id }} .all-products-grid.is-loading .all-products-grid__pagination {
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  #ProductsGrid-{{ section.id }} .all-products-grid__loading-overlay {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.5);
    z-index: 5;
    border-radius: var(--rounded-radius, 8px);
  }
  #ProductsGrid-{{ section.id }} .all-products-grid.is-loading .all-products-grid__loading-overlay {
    display: flex;
  }
{%- endstyle -%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  id="ProductsGrid-{{ section.id }}"
  class="section--padding page-width page-width--{{ section.settings.container }} color-{{ section.settings.color_scheme }}"
>
  {%- if section.settings.heading != blank
    or section.settings.subheading != blank
    or section.settings.description != blank
  -%}
    <div class="section__header s__header rich-text text-{{ section.settings.header_alignment }} mb-6 md:mb-8">
      {%- if section.settings.subheading != blank -%}
        <p class="rich-text__subheading text-subheading mb-2">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="rich-text__text rte text-subtext mt-2">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <all-products-grid
    class="all-products-grid block relative"
    data-section-id="{{ section.id }}"
  >
    {%- paginate target_collection.products by products_to_display -%}
      {%- if target_collection.products.size == 0 -%}
        <div class="empty-state flex flex-col items-center justify-center gap-4 text-center py-12">
          <p class="h4">{{ 'collections.general.empty' | t }}</p>
        </div>
      {%- else -%}
        <div
          id="ProductsList-{{ section.id }}"
          class="grid-list products-list products-list--list-{{ settings.pcard_list_style }} f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}"
          style="--f-columns-mobile: {{ columns_mobile }}; --f-columns-md: {{ columns_tablet }};--f-columns-lg: {{ columns_laptop }}; --f-columns-xl: {{ columns_desktop }};"
          {% if settings.pcard_style == 'card' %}
            data-grid-class="color-{{ settings.pcard_color_scheme }}"
          {% endif %}
          {% if settings.pcard_list_style == 'card' %}
            data-list-class="color-{{ settings.pcard_color_scheme }}"
          {% endif %}
        >
          {%- for product in target_collection.products -%}
            <div class="f-column product-column">
              {%- render 'card-product',
                product: product,
                parent_color_scheme: section.settings.color_scheme,
                enable_compare_checkbox: settings.enable_product_compare,
                image_sizes: image_sizes,
                section_id: section.id,
                section_index: section.index,
                index: forloop.index
              -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="all-products-grid__pagination mt-8 md:mt-12 flex justify-center">
            {%- render 'pagination', paginate: paginate, anchor: anchor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}

    <div class="all-products-grid__loading-overlay" aria-hidden="true">
      {%- render 'loading-spinner' -%}
    </div>
  </all-products-grid>
</div>

<script>
  if (!customElements.get('all-products-grid')) {
    customElements.define(
      'all-products-grid',
      class AllProductsGrid extends HTMLElement {
        constructor() {
          super();
          this.init();
        }

        init() {
          this.addEventListener('click', (event) => {
            const link = event.target.closest('.pagination a');
            if (!link) return;

            const href = link.getAttribute('href');
            if (!href) return;

            event.preventDefault();
            this.fetchPage(href);
          });

          window.addEventListener('popstate', (event) => {
            if (event.state && event.state.allProductsGridUrl) {
              this.fetchPage(event.state.allProductsGridUrl, false);
            }
          });
        }

        async fetchPage(urlStr, pushState = true) {
          const sectionId = this.dataset.sectionId;
          const url = new URL(urlStr, window.location.origin);

          this.classList.add('is-loading');

          const fetchUrl = new URL(url.pathname + url.search, window.location.origin);
          fetchUrl.searchParams.set('section_id', sectionId);

          try {
            const response = await fetch(fetchUrl.toString());
            if (!response.ok) throw new Error('Fetch failed');

            const text = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(text, 'text/html');
            const newContent =
              doc.querySelector(`all-products-grid[data-section-id="${sectionId}"]`) ||
              doc.querySelector('all-products-grid');

            if (newContent) {
              this.innerHTML = newContent.innerHTML;

              if (pushState) {
                window.history.pushState({ allProductsGridUrl: urlStr }, '', urlStr);
              }

              const headerOffset = 100;
              const elementPosition = this.getBoundingClientRect().top;
              const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
              window.scrollTo({
                top: Math.max(0, offsetPosition),
                behavior: 'smooth',
              });

              document.dispatchEvent(new CustomEvent('collection:rerendered'));
              document.dispatchEvent(new CustomEvent('page:loaded'));
            } else {
              window.location.href = urlStr;
            }
          } catch (e) {
            console.error('AllProductsGrid pagination error:', e);
            window.location.href = urlStr;
          } finally {
            this.classList.remove('is-loading');
          }
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "All Products Grid",
  "class": "all-products-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "hd1", "label": "Headline 1" },
        { "value": "hd2", "label": "Headline 2" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Collection Settings"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a collection. Leave blank to automatically show all products."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 32,
      "label": "Products per page",
      "info": "Number of products shown per page. Default is 32."
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "label": "Mobile columns"
    },
    {
      "type": "select",
      "id": "column_gap",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "2xs", "label": "2XS" },
        { "value": "extra-small", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "small",
      "label": "Column gap"
    },
    {
      "type": "select",
      "id": "row_gap",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "none", "label": "None" },
        { "value": "extra-small", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "large",
      "label": "Row gap"
    },
    {
      "type": "header",
      "content": "Section Layout & Style"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "fixed", "label": "Fixed width" }
      ],
      "default": "fixed",
      "label": "Container"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "label": "Show section divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        { "value": "fixed", "label": "Fixed" },
        { "value": "full", "label": "Full" }
      ],
      "default": "fixed",
      "label": "Divider width"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "All Products Grid",
      "settings": {
        "heading": "All Products",
        "products_per_page": 32,
        "columns_desktop": 4,
        "columns_mobile": "2"
      }
    }
  ]
}
{% endschema %}
